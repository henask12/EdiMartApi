# --- Required on Render / Railway (set in the service's environment, NOT in this file) ---
DATABASE_URL="postgresql://user:password@host:5432/railway?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
WEB_ORIGIN="https://your-app.vercel.app"            # the web app's URL (comma-separate several)
PUBLIC_API_URL="https://edimartapi-1.onrender.com"   # this API's public URL

# --- Sessions ---
# How long a login lasts, in hours (default 8). Drives the JWT and the browser cookie.
SESSION_TTL_HOURS=8
# Login attempts allowed per account per 15 minutes (default 8).
LOGIN_RATE_LIMIT=8

# --- First-run setup (off unless SETUP_ENABLED=1; leave it off in production after setup) ---
SETUP_ENABLED=0
SETUP_SECRET="pick-a-long-random-setup-key"          # X-Setup-Key header for POST /setup/seed
ADMIN_EMAIL="owner@edisims.local"
# Owner password for the first run. If unset, one is generated and printed ONCE in the server log.
ADMIN_INITIAL_PASSWORD=""
SEED_DEMO_USERS=0                                    # 1 = also create cashier + staff demo users
SEED_CATALOG=1                                       # 0 = create no starter products
# AUTO_SEED=1                                        # seed automatically when the DB has no users
# The seed refuses to run when users, sales or stock movements already exist.

# --- File storage (product photos public, payment proofs private) ---
STORAGE_DRIVER=local                                 # local | s3
UPLOAD_DIR="./uploads"                               # local driver only; needs a persistent disk
# FILE_URL_SECRET=""                                 # signs private-file links (defaults to JWT_SECRET)
# S3-compatible (Cloudflare R2, AWS S3, Supabase Storage):
# S3_BUCKET=""
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # omit for AWS S3
# S3_REGION="auto"                                              # e.g. eu-west-1 for AWS
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL="https://img.example.com"       # public URL of the bucket/CDN for product photos
# S3_FORCE_PATH_STYLE=0

# --- Alerts ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Edi's Collection <alerts@yourdomain.com>"
EXPIRY_ALERT_DAYS=7

# --- Observability (Phase 9) ---
# LOG_LEVEL=info
# SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Backups (scripts/backup-pg.sh / backup-pg.mjs) ---
# BACKUP_DIR=./backups
# BACKUP_S3_PREFIX=edimart/backups
# BACKUP_RETENTION_DAYS=14
# (also reuses S3_* above when uploading dumps)

# --- Railway only ---
# DATABASE_URL = reference from Postgres service (${{Postgres.DATABASE_URL}})
