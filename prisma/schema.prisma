generator client {
  provider = "prisma-client-js"
  // Standalone Render build — must generate into this repo's node_modules.
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionKey {
  PRODUCTS_VIEW
  PRODUCTS_CREATE
  PRODUCTS_EDIT
  PRODUCTS_DEACTIVATE
  PRODUCTS_SELL
  PRODUCTS_RESERVE
  PRODUCTS_RESTOCK
  PRODUCTS_EXPORT
  CATEGORIES_MANAGE
  PRODUCT_TYPES_MANAGE
  STOCK_RECEIVE
  STOCK_HISTORY_VIEW
  SALES_CREATE
  SALES_VIEW
  SALES_EXPORT
  RESERVATIONS_MANAGE
  USERS_MANAGE
  ROLES_MANAGE
  SETTINGS_EMAILS
  REPORTING_VIEW
  // Phase 1 additions (see src/permissions/permission-catalog.ts)
  SALES_VIEW_OWN
  SALES_VIEW_ALL
  SALES_VOID
  SALES_REFUND
  DISCOUNT_APPLY
  DISCOUNT_ABOVE_LIMIT
  PRICE_OVERRIDE
  CASH_DRAWER_OPEN
  SHIFT_MANAGE
  SHIFT_VIEW_ALL
  CUSTOMERS_VIEW
  CUSTOMERS_MANAGE
  CUSTOMER_CREDIT_MANAGE
  PROMOTIONS_MANAGE
  SUPPLIERS_MANAGE
  PURCHASING_MANAGE
  PURCHASE_APPROVE
  SUPPLIER_PAYMENTS_MANAGE
  STOCK_VIEW
  STOCK_COUNT
  STOCK_COUNT_APPROVE
  STOCK_ADJUST
  STOCK_TRANSFER
  STOCK_WRITE_OFF
  PRICES_MANAGE
  LOCATIONS_MANAGE
  LABELS_PRINT
  REPORTS_VIEW_COST_PROFIT
  EXPORTS_RUN
  SETTINGS_MANAGE
  AUDIT_VIEW
}

enum ReservationStatus {
  RESERVED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum MovementType {
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER
  RESERVE
  RELEASE_RESERVE
  DAMAGE
  WRITE_OFF
  COUNT
}

enum TaxCategory {
  STANDARD
  ZERO_RATED
  EXEMPT
}

enum AdjustReason {
  DAMAGED
  EXPIRED
  THEFT_LOSS
  INTERNAL_USE
  GIFT_SAMPLE
  DATA_CORRECTION
  OTHER
}

enum TransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum StockCountType {
  FULL
  CYCLE
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  POSTED
  CANCELLED
}

enum LabelJobStatus {
  PENDING
  PRINTED
  CANCELLED
}

enum BarcodeKind {
  EAN13
  CODE128
  INTERNAL
  OTHER
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRY
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  isProtected Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
}

model RolePermission {
  roleId     String
  role       Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PermissionKey

  @@id([roleId, permission])
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  displayName     String?
  isActive        Boolean          @default(true)
  mustChangePassword Boolean       @default(false)
  /// bcrypt hash of the optional 4-6 digit manager approval PIN.
  pinHash            String?
  pinFailedAttempts  Int           @default(0)
  pinLockedUntil     DateTime?
  locale             String?
  roleId          String
  role            Role             @relation(fields: [roleId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  auditLogs       AuditLog[]
  stockMovements  StockMovement[]
  sales           Sale[]           @relation("SaleCreatedBy")
  stockBatches       StockBatch[]
  reservations       Reservation[]
  stockTransfers     StockTransfer[]      @relation("TransferCreatedBy")
  stockTransferRecv  StockTransfer[]      @relation("TransferReceivedBy")
  stockCounts        StockCount[]         @relation("CountCreatedBy")
  stockCountsPosted  StockCount[]         @relation("CountPostedBy")
  priceChanges       PriceChange[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model ProductType {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String            @id @default(cuid())
  sku           String?           @unique
  name          String
  /// Amharic display name (optional).
  nameAm        String?
  brand         String?
  categoryId    String
  category      Category          @relation(fields: [categoryId], references: [id])
  productTypeId String?
  productType   ProductType?      @relation(fields: [productTypeId], references: [id])
  imagePath       String?
  description     String?
  originCountry   String?
  sellingPrice    Decimal           @db.Decimal(12, 2)
  costPrice     Decimal           @db.Decimal(12, 2) @default(0)
  /// Reorder point (alert when available falls to or below this).
  restockAt     Int               @default(0)
  /// Suggested reorder quantity.
  restockQty    Int               @default(0)
  minStock      Int               @default(0)
  maxStock      Int               @default(0)
  leadTimeDays  Int               @default(0)
  taxCategory   TaxCategory       @default(STANDARD)
  /// When true, receiving should capture lot/expiry; sales use FEFO and record batch links.
  trackBatches  Boolean           @default(false)
  defaultLocationId String?
  defaultLocation   Location?     @relation("ProductDefaultLocation", fields: [defaultLocationId], references: [id])
  expiryDate    DateTime?
  isActive      Boolean           @default(true)
  /// Soft-archive: products with history are never deleted.
  archivedAt    DateTime?
  lastOutOfStockAlertAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  inventoryItems InventoryItem[]
  saleLines     SaleLine[]
  stockBatches  StockBatch[]
  reservations  Reservation[]
  barcodes      ProductBarcode[]
  priceChanges  PriceChange[]
  labelJobs     LabelReprintQueue[]
  transferLines StockTransferLine[]
  countLines    StockCountLine[]
  snapshots     InventorySnapshot[]

  @@unique([categoryId, name])
  @@index([expiryDate])
  @@index([brand])
  @@index([archivedAt])
}

model ProductBarcode {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode   String      @unique
  kind      BarcodeKind @default(INTERNAL)
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([productId])
}

model Location {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  /// Groups locations into a physical shop; second store later = new storeCode.
  storeCode      String          @default("DEFAULT_STORE")
  sellable       Boolean         @default(true)
  sortOrder      Int             @default(0)
  binCode        String?
  isActive       Boolean         @default(true)
  inventoryItems InventoryItem[]
  stockBatches   StockBatch[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  stockCounts    StockCount[]
  defaultForProducts Product[]   @relation("ProductDefaultLocation")
  snapshots      InventorySnapshot[]
  createdAt      DateTime        @default(now())

  @@index([storeCode, sellable])
}

model InventoryItem {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location        @relation(fields: [locationId], references: [id])
  quantityOnHand Decimal         @db.Decimal(18, 4) @default(0)
  averageCost    Decimal         @db.Decimal(14, 4) @default(0)
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([productId, locationId])
}

model StockBatch {
  id                String          @id @default(cuid())
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Location this batch currently sits in (set on receive / transfer).
  locationId        String?
  location          Location?       @relation(fields: [locationId], references: [id])
  lotNumber         String?
  qtyReceived       Decimal         @db.Decimal(18, 4)
  qtyRemaining      Decimal         @db.Decimal(18, 4)
  unitCost          Decimal         @db.Decimal(14, 4) @default(0)
  expiryDate        DateTime?
  receivedAt        DateTime        @default(now())
  receivedByUserId  String?
  receivedBy        User?           @relation(fields: [receivedByUserId], references: [id])
  stockMovements    StockMovement[]
  saleLineBatches   SaleLineBatch[]

  @@index([productId, receivedAt])
  @@index([expiryDate])
  @@index([locationId, productId])
  @@index([lotNumber])
}

model StockMovement {
  id              String         @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  stockBatchId    String?
  stockBatch      StockBatch?    @relation(fields: [stockBatchId], references: [id])
  type            MovementType
  qtyDelta        Decimal        @db.Decimal(18, 4)
  unitCost        Decimal?       @db.Decimal(14, 4)
  beforeOnHand    Decimal?       @db.Decimal(18, 4)
  afterOnHand     Decimal?       @db.Decimal(18, 4)
  reasonCode      AdjustReason?
  refType         String?
  refId           String?
  notes           String?
  metadata        Json?
  createdByUserId String?
  createdBy       User?          @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime       @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([refType, refId])
  @@index([reasonCode])
}

model Reservation {
  id              String            @id @default(cuid())
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  quantity        Decimal           @db.Decimal(18, 4)
  status          ReservationStatus @default(RESERVED)
  customerName    String?
  expiresAt       DateTime?
  createdByUserId String
  createdBy       User              @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([productId, status])
  @@index([status])
  @@index([status, expiresAt])
}

model Sale {
  id              String                @id @default(cuid())
  saleNumber      String                @unique
  status          String                @default("COMPLETED")
  subtotal        Decimal               @db.Decimal(12, 2)
  discountTotal   Decimal               @db.Decimal(12, 2) @default(0)
  taxTotal        Decimal               @db.Decimal(12, 2) @default(0)
  grandTotal      Decimal               @db.Decimal(12, 2)
  createdByUserId String
  createdBy       User                  @relation("SaleCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime              @default(now())
  lines           SaleLine[]
  payments        PaymentAllocation[]
  attachments     SaleAttachment[]

  @@index([createdAt])
}

model SaleAttachment {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  imagePath String
  createdAt DateTime @default(now())

  @@index([saleId])
}

model SaleLine {
  id           String   @id @default(cuid())
  saleId       String
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @db.Decimal(12, 2)
  unitCostAtSale Decimal  @db.Decimal(14, 4) @default(0)
  lineDiscount   Decimal  @db.Decimal(12, 2) @default(0)
  taxAmount    Decimal  @db.Decimal(12, 2) @default(0)
  lineTotal    Decimal  @db.Decimal(12, 2)
  batchAllocations SaleLineBatch[]
}

/// FEFO batch allocations for a sale line (traceability).
model SaleLineBatch {
  id           String     @id @default(cuid())
  saleLineId   String
  saleLine     SaleLine   @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  stockBatchId String?
  stockBatch   StockBatch? @relation(fields: [stockBatchId], references: [id])
  quantity     Decimal    @db.Decimal(18, 4)

  @@index([saleLineId])
  @@index([stockBatchId])
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  TELEBIRR
  CBE_BIRR
  MPESA
  BANK_TRANSFER
}

model PaymentAllocation {
  id     String        @id @default(cuid())
  saleId String
  sale   Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)
  reference String?
}

model NotificationEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model NotificationLog {
  id        String           @id @default(cuid())
  type      NotificationType
  subject   String
  body      String
  sentAt    DateTime         @default(now())
  metadata  Json?
}

/// Per-scope, per-business-day counters (sale numbers, and later returns, POs, shifts).
model DocumentCounter {
  scope String
  /// Business-time calendar date, YYYY-MM-DD (Africa/Addis_Ababa).
  date  String
  value Int    @default(0)

  @@id([scope, date])
}

/// Makes retried write requests (checkout) safe: the same key returns the original result.
model IdempotencyKey {
  id          String   @id @default(cuid())
  scope       String
  key         String
  requestHash String
  userId      String
  saleId      String?
  createdAt   DateTime @default(now())

  @@unique([scope, key])
  @@index([createdAt])
}

/// A manager's PIN approval of one sensitive action. The token is shown once; only its hash is
/// stored. Single use, short lived, bound to one action and one requesting user.
model Approval {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  action      String
  approverId  String
  requesterId String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

/// Owner-editable shop settings (key/value). Known keys and defaults live in code.
model StoreSetting {
  key             String   @id
  value           Json
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
}

model StockTransfer {
  id              String         @id @default(cuid())
  transferNumber  String         @unique
  status          TransferStatus @default(DRAFT)
  fromLocationId  String
  fromLocation    Location       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId    String
  toLocation      Location       @relation("TransferTo", fields: [toLocationId], references: [id])
  notes           String?
  createdByUserId String
  createdBy       User           @relation("TransferCreatedBy", fields: [createdByUserId], references: [id])
  receivedByUserId String?
  receivedBy      User?          @relation("TransferReceivedBy", fields: [receivedByUserId], references: [id])
  sentAt          DateTime?
  receivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lines           StockTransferLine[]

  @@index([status, createdAt])
  @@index([fromLocationId])
  @@index([toLocationId])
}

model StockTransferLine {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id])
  quantity   Decimal       @db.Decimal(18, 4)
  /// Optional preferred batch to move; otherwise FEFO at send time.
  stockBatchId String?

  @@index([transferId])
  @@index([productId])
}

model StockCount {
  id              String           @id @default(cuid())
  countNumber     String           @unique
  type            StockCountType   @default(FULL)
  status          StockCountStatus @default(DRAFT)
  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id])
  notes           String?
  startedAt       DateTime?
  postedAt        DateTime?
  createdByUserId String
  createdBy       User             @relation("CountCreatedBy", fields: [createdByUserId], references: [id])
  postedByUserId  String?
  postedBy        User?            @relation("CountPostedBy", fields: [postedByUserId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lines           StockCountLine[]

  @@index([status, createdAt])
  @@index([locationId])
}

model StockCountLine {
  id                 String     @id @default(cuid())
  countId            String
  count              StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId          String
  product            Product    @relation(fields: [productId], references: [id])
  /// System on-hand at count start (so sales during count can be reconciled).
  systemQtySnapshot  Decimal    @db.Decimal(18, 4)
  countedQty         Decimal?   @db.Decimal(18, 4)
  /// Set when posting: counted − (snapshot + movements since start).
  varianceQty        Decimal?   @db.Decimal(18, 4)
  needsRecount       Boolean    @default(false)
  notes              String?

  @@unique([countId, productId])
  @@index([productId])
}

model PriceChange {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice        Decimal  @db.Decimal(12, 2)
  newPrice        Decimal  @db.Decimal(12, 2)
  effectiveAt     DateTime @default(now())
  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  note            String?

  @@index([productId, effectiveAt])
  @@index([effectiveAt])
}

model LabelReprintQueue {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason    String
  status    LabelJobStatus @default(PENDING)
  createdAt DateTime       @default(now())
  printedAt DateTime?

  @@index([status, createdAt])
  @@index([productId])
}

/// Daily quantity/value snapshot per product×location for fast history charts.
model InventorySnapshot {
  id            String   @id @default(cuid())
  /// Business-time calendar date YYYY-MM-DD (Africa/Addis_Ababa).
  date          String
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location @relation(fields: [locationId], references: [id])
  quantity      Decimal  @db.Decimal(18, 4)
  valueAtCost   Decimal  @db.Decimal(14, 2)
  valueAtRetail Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  @@unique([date, productId, locationId])
  @@index([date])
}
